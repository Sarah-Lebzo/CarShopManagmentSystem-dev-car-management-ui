@model CarShopManagementSystem.Models.Manufacturer

@{
    ViewData["Title"] = "إضافة شركة";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-light">
            <h3 class="mb-0">➕ @ViewData["Title"]</h3>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label">اسم الشركة</label>
                    <input type="text" name="Name" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">شعار الشركة</label>
                    <input type="file" name="LogoFile" class="form-control" />
                </div>

                <div id="subBrandsContainer" class="mb-3">
                    <label class="form-label">الماركات الفرعية</label>
                    <input type="text" name="SubBrands" class="form-control mb-2" placeholder="مثال: Lexus" />
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary mb-3" onclick="addSubBrand()">➕ إضافة ماركة فرعية</button>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">⬅️ رجوع</a>
                    <button type="submit" class="btn btn-success">💾 حفظ</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function addSubBrand() {
            var container = document.getElementById("subBrandsContainer");
            var input = document.createElement("input");
            input.type = "text";
            input.name = "SubBrands";
            input.className = "form-control mb-2";
            input.placeholder = "مثال: Lexus";
            container.appendChild(input);
        }
    </script>
}
