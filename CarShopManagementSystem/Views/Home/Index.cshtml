@model IEnumerable<CarShopManagementSystem.Models.Car>

@{
    ViewData["Title"] = "الصفحة الرئيسية";
}

<!-- Hero Section -->
<div class="hero-section position-relative">
    <div id="carouselHero" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="/images/hero/hero1.jpg.svg" class="d-block w-100" alt="سيارات فاخرة" style="height: 500px; object-fit: cover;">
            </div>
            <div class="carousel-item">
                <img src="/images/hero/hero2.jpg.svg" class="d-block w-100" alt="سيارات رياضية" style="height: 500px; object-fit: cover;">
            </div>
            <div class="carousel-item">
                <img src="/images/hero/hero3.jpg.svg" class="d-block w-100" alt="سيارات عائلية" style="height: 500px; object-fit: cover;">
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselHero" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">السابق</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselHero" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">التالي</span>
        </button>
    </div>
    <div class="hero-overlay position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <div class="hero-content text-white">
                        <h1 class="display-4 fw-bold">أفضل السيارات بأفضل الأسعار</h1>
                        <p class="lead">اكتشف مجموعتنا الواسعة من السيارات الجديدة والمستعملة</p>
                        <div class="mt-4">
                            <a asp-controller="Cars" asp-action="Index" class="btn btn-primary btn-lg me-2">استعراض السيارات</a>
                            @if (Context.Session.GetString("UserId") == null)
                            {
                                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg">تسجيل حساب جديد</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Featured Cars Section -->
<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="section-title">سيارات مميزة</h2>
            <p class="text-muted">اكتشف أحدث السيارات المضافة إلى معرضنا</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-controller="Cars" asp-action="Index" class="btn btn-outline-primary">عرض جميع السيارات</a>
        </div>
    </div>

    <div class="row">
        @foreach (var car in Model.Take(6))
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm hover-card">
                    <div class="position-relative">
                        <img src="@(string.IsNullOrEmpty(car.ImageUrl) ? "/images/cars/default-car.jpg" : car.ImageUrl)"
                             class="card-img-top"
                             alt="@car.Manufacturer?.Name @car.Model"
                             style="height: 200px; object-fit: cover;">

                        @if (!car.IsAvailable)
                        {
                            <div class="position-absolute top-0 end-0 bg-danger text-white p-2 m-2 rounded">محجوزة</div>
                        }
                        @if (car.IsUsed)
                        {
                            <div class="position-absolute top-0 start-0 bg-warning text-dark p-2 m-2 rounded">مستعملة</div>
                        }
                    </div>

                    <div class="card-body d-flex">
                        <img src="@(car.Manufacturer?.LogoPath != null ? "/images/brands/" + car.Manufacturer.LogoPath : "/images/brands/no.png")"
                             alt="Logo"
                             style="height:50px; width:auto; margin-right:10px;" />
                        <div>
                            <h5 class="card-title">
                                @car.Manufacturer?.Name @car.Model @car.Year
                            </h5>
                            @if (car.SubBrand != null)
                            {
                                <p class="mb-1 text-muted">السب براند: @car.SubBrand.Name</p>
                            }
                            <p class="card-text text-primary fw-bold">@car.EstimatedPriceMax.ToString("C0")</p>
                            <div class="d-flex justify-content-between small">
                                <span><i class="bi bi-palette"></i> @car.Color</span>
                                @if (car.IsUsed && car.Mileage.HasValue)
                                {
                                    <span><i class="bi bi-speedometer2"></i> @car.Mileage كم</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-white border-top-0 d-flex justify-content-between">
                        <a asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id" class="btn btn-outline-primary">
                            <i class="bi bi-info-circle"></i> التفاصيل
                        </a>
                        @if (car.IsAvailable)
                        {
                            <a asp-controller="Cars" asp-action="Book" asp-route-id="@car.Id" class="btn btn-success">
                                <i class="bi bi-calendar-check"></i> حجز
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Categories Section -->
<div class="bg-light py-5 mt-5">
    <div class="container">
        <h2 class="section-title text-center mb-5">تصفح حسب الفئة</h2>
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card category-card text-center">
                    <div class="card-body">
                        <div class="category-icon mb-3">
                            <i class="bi bi-car-front fs-1"></i>
                        </div>
                        <h3 class="h4">سيارات جديدة</h3>
                        <p>استكشف أحدث موديلات السيارات الجديدة</p>
                        <a asp-controller="Cars" asp-action="Index" asp-route-isUsed="false" class="btn btn-outline-primary">استعراض</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card category-card text-center">
                    <div class="card-body">
                        <div class="category-icon mb-3">
                            <i class="bi bi-car-front-fill fs-1"></i>
                        </div>
                        <h3 class="h4">سيارات مستعملة</h3>
                        <p>اكتشف سيارات مستعملة بحالة ممتازة وأسعار مناسبة</p>
                        <a asp-controller="Cars" asp-action="Index" asp-route-isUsed="true" class="btn btn-outline-primary">استعراض</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card category-card text-center">
                    <div class="card-body">
                        <div class="category-icon mb-3">
                            <i class="bi bi-star fs-1"></i>
                        </div>
                        <h3 class="h4">عروض خاصة</h3>
                        <p>تخفيضات وعروض حصرية على مجموعة مختارة من السيارات</p>
                        <a asp-controller="Cars" asp-action="Index" class="btn btn-outline-primary">استعراض</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Why Choose Us Section -->
<div class="container mt-5">
    <h2 class="section-title text-center mb-5">لماذا تختارنا؟</h2>
    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="feature text-center">
                <div class="feature-icon mb-3">
