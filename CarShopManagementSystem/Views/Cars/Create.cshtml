@model CarShopManagementSystem.Models.Car

@{
    ViewData["Title"] = "إضافة سيارة جديدة";
    var brands = ViewData["Brands"] as List<CarShopManagementSystem.Models.Manufacturer> ?? new List<CarShopManagementSystem.Models.Manufacturer>();
    bool isAdmin = ViewData["IsAdmin"] != null && (bool)ViewData["IsAdmin"];
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}
<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-light">
            <h1 class="h3 mb-0">@ViewData["Title"]</h1>
        </div>
        <div class="card-body">
            <form asp-action="Create" enctype="multipart/form-data" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <!-- العمود الأول -->
                    <div class="col-md-6">
                        <!-- الشركة المصنعة -->
                        <div class="mb-3">
                            <label class="form-label">الشركة المصنعة</label>
                            <div class="d-flex align-items-center">
                                <select id="ManufacturerId" name="ManufacturerId" class="form-select me-3">
                                    <option value="">اختر الشركة</option>
                                    @foreach (var m in brands)
                                    {
                                        <option value="@m.Id" data-logo="@m.LogoPath">@m.Name</option>
                                    }
                                </select>
                                <img id="brandLogoPreview" src="/logos/no-logo.png" alt="Logo" style="height:50px;" />
                            </div>
                        </div>

                        <!-- SubBrand -->
                        <div class="mb-3">
                            <label class="form-label">الفئة / الموديل الفرعي</label>
                            <select id="SubBrandId" name="SubBrandId" class="form-select">
                                <option value="">اختر الفئة</option>
                            </select>
                        </div>

                        <!-- الموديل -->
                        <div class="mb-3">
                            <label asp-for="Model" class="form-label">الموديل</label>
                            <input asp-for="Model" class="form-control" />
                            <span asp-validation-for="Model" class="text-danger"></span>
                        </div>

                        <!-- السنة -->
                        <div class="mb-3">
                            <label asp-for="Year" class="form-label">سنة الصنع</label>
                            <input asp-for="Year" class="form-control" type="number" min="1900" max="@DateTime.Now.Year" />
                            <span asp-validation-for="Year" class="text-danger"></span>
                        </div>

                        <!-- اللون -->
                        <div class="mb-3">
                            <label asp-for="Color" class="form-label">اللون</label>
                            <input asp-for="Color" class="form-control" />
                            <span asp-validation-for="Color" class="text-danger"></span>
                        </div>

                        @* Admin Only Fields *@

                            <div class="mb-3">
                                <label asp-for="Costing" class="form-label">سعر التكلفة</label>
                                <input asp-for="Costing" class="form-control" type="number" min="0" step="0.01" />
                                <span asp-validation-for="Costing" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="EstimatedPriceMin" class="form-label">أدنى سعر متوقع</label>
                                <input asp-for="EstimatedPriceMin" class="form-control" type="number" min="0" step="0.01" />
                                <span asp-validation-for="EstimatedPriceMin" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="EstimatedPriceMax" class="form-label">أعلى سعر متوقع</label>
                                <input asp-for="EstimatedPriceMax" class="form-control" type="number" min="0" step="0.01" />
                                <span asp-validation-for="EstimatedPriceMax" class="text-danger"></span>
                            </div>
                    </div>

                    <!-- العمود الثاني -->
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="IsUsed" class="form-label">حالة السيارة</label>
                            <div class="form-check">
                                <input asp-for="IsUsed" class="form-check-input" type="checkbox" id="isUsedCheck" />
                                <label class="form-check-label" for="isUsedCheck">سيارة مستعملة</label>
                            </div>
                        </div>

                        <div class="mb-3" id="mileageDiv">
                            <label asp-for="Mileage" class="form-label">المسافة المقطوعة (كم)</label>
                            <input asp-for="Mileage" class="form-control" type="number" min="0" />
                            <span asp-validation-for="Mileage" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label for="ImageFile" class="form-label">صورة السيارة</label>
                            <input type="file" name="ImageFile" id="ImageFile" class="form-control" accept="image/*" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">الوصف</label>
                            <textarea asp-for="Description" class="form-control" rows="6"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> العودة للقائمة</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> حفظ</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            function toggleMileageField() {
                if ($("#isUsedCheck").is(":checked")) {
                    $("#mileageDiv").show();
                } else {
                    $("#mileageDiv").hide();
                    $("#Mileage").val("");
                }
            }
            toggleMileageField();
            $("#isUsedCheck").change(toggleMileageField);

            $("#ManufacturerId").change(function () {
                var selectedOption = $(this).find(':selected');
                var logo = selectedOption.data('logo') || "logos/no-logo.png";
                $("#brandLogoPreview").attr("src", "/" + logo);

                var manufacturerId = $(this).val();
                $("#SubBrandId").empty().append('<option value="">اختر الفئة</option>');

                if (manufacturerId) {
                    $.getJSON('/Cars/GetSubBrands', { manufacturerId: manufacturerId }, function (data) {
                        if (data && data.length > 0) {
                            $.each(data, function (i, sub) {
                                var subId = sub.Id || sub.id;
                                var subName = sub.Name || sub.name;
                                if(subId && subName){
                                    $("#SubBrandId").append('<option value="' + subId + '">' + subName + '</option>');
                                }
                            });
                        }
                    });
                }
            });
        });
    </script>
}
