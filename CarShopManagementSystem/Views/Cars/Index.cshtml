@model IEnumerable<CarShopManagementSystem.Models.Car>

@{
    ViewData["Title"] = "قائمة السيارات";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    @if (Context.Session.GetInt32("IsAdmin") == 1)
    {
        <p>
            <a asp-action="Create" class="btn btn-primary mb-3">
                <i class="bi bi-plus-circle"></i> إضافة سيارة جديدة
            </a>
            <a asp-controller="Manufacturers" asp-action="Index" class="btn btn-secondary mb-3 ms-2">
                <i class="bi bi-building"></i> إدارة الشركات
            </a>
        </p>
    }

    <div class="card shadow mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">البحث والتصفية</h5>
        </div>
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="ابحث عن موديل، مصنع أو وصف..." />
                        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> بحث</button>
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="isUsed" class="form-select" onchange="this.form.submit()">
                        <option value="">جميع السيارات</option>
                        <option value="false" selected="@(ViewData["IsUsedFilter"] != null && !(bool)ViewData["IsUsedFilter"])">سيارات جديدة</option>
                        <option value="true" selected="@(ViewData["IsUsedFilter"] != null && (bool)ViewData["IsUsedFilter"])">سيارات مستعملة</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">إعادة تعيين</a>
                </div>
            </form>
        </div>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm hover-card">
                    <div class="position-relative">
                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/cars/default-car.jpg" : item.ImageUrl)" class="card-img-top" alt="@item.Manufacturer?.Name @item.Model" style="height: 200px; object-fit: cover;">
                        @if (!item.IsAvailable)
                        {
                            <div class="position-absolute top-0 end-0 bg-danger text-white p-2 m-2 rounded">محجوزة</div>
                        }
                        @if (item.IsUsed)
                        {
                            <div class="position-absolute top-0 start-0 bg-warning text-dark p-2 m-2 rounded">مستعملة</div>
                        }
                    </div>

                    <div class="card-body d-flex">
                        <!-- شعار المصنع -->
                        <img src="@(item.Manufacturer?.LogoPath != null ? "/" + item.Manufacturer.LogoPath : "/no.png")" alt="Logo" style="height:50px; margin-right:10px;" />

                        <div>
                            <!-- اسم المصنع -->
                            <h5 class="card-title mb-0">@item.Manufacturer?.Name</h5>
                            <!-- اسم SubBrand -->
                            @if (item.SubBrand != null)
                            {
                                <p class="text-muted mb-1">@item.SubBrand.Name</p>
                            }
                            <!-- الموديل والسنة -->
                            <p class="mb-1">@item.Model @item.Year</p>
                            <!-- السعر -->
                            <p class="card-text text-primary fw-bold">@item.EstimatedPriceMax.ToString("C0")</p>
                            <!-- وصف قصير -->
                            <p class="card-text">@(item.Description?.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)</p>
                            <!-- اللون والمسافة -->
                            <div class="d-flex">
                                <span><i class="bi bi-palette"></i> @item.Color</span>
                                @if (item.IsUsed && item.Mileage.HasValue)
                                {
                                    <span><i style="margin-right: 70px;" class="bi bi-speedometer2"></i> @item.Mileage كم</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-white border-top-0 d-flex justify-content-between">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary"><i class="bi bi-info-circle"></i> التفاصيل</a>
                        @if (item.IsAvailable)
                        {
                            <a asp-action="Book" asp-route-id="@item.Id" class="btn btn-success"><i class="bi bi-calendar-check"></i> حجز</a>
                        }
                        @if (Context.Session.GetInt32("IsAdmin") == 1)
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="dropdownMenuButton@(item.Id)" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear"></i>
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton@(item.Id)">
                                    <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil"></i> تعديل</a></li>
                                    <li><a class="dropdown-item" asp-action="Delete" asp-route-id="@item.Id"><i class="bi bi-trash"></i> حذف</a></li>
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>



