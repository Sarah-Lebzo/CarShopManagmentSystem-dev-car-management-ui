@model CarShopManagementSystem.Models.Car

@{
    ViewData["Title"] = "تفاصيل السيارة";
    bool isAdmin = Context.Session.GetInt32("IsAdmin") == 1;
}

<div class="container mt-4">
    <div class="card shadow">
        <!-- الهيدر -->
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h1 class="h3 mb-0">@Model.Manufacturer?.Name @Model.Model @Model.Year</h1>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> العودة للقائمة</a>
                @if (isAdmin)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> تعديل</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger"><i class="bi bi-trash"></i> حذف</a>
                }
            </div>
        </div>

        <!-- جسم البطاقة -->
        <div class="card-body">
            <div class="row">
                <!-- صورة السيارة -->
                <div class="col-md-6 mb-3">
                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/cars/default-car.jpg" : Model.ImageUrl)"
                         class="img-fluid rounded"
                         alt="@Model.Manufacturer?.Name @Model.Model"
                         style="max-height:400px; width:100%; object-fit:cover;">
                </div>

                <!-- معلومات السيارة -->
                <div class="col-md-6">
                    <div class="mb-4">
                        <h2 class="h4 text-primary mb-3">معلومات السيارة</h2>
                        <div class="row">

                            <!-- الماركة + السب براند + اللوجو -->
                            <div class="col-12 mb-3">
                                <div class="d-flex align-items-center">
                                    <img src="@(Model.Manufacturer?.LogoPath != null ? "/" + Model.Manufacturer.LogoPath : "/images/no-logo.png")"
                                         alt="@Model.Manufacturer?.Name"
                                         class="rounded-circle me-3"
                                         style="width:50px; height:50px; object-fit:cover;" />
                                    <div>
                                        <div class="fw-bold">@Model.Manufacturer?.Name</div>
                                        @if (Model.SubBrand != null)
                                        {
                                            <div class="text-muted small">@Model.SubBrand.Name</div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- الموديل -->
                            <div class="col-md-6 mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-light p-3 rounded-circle me-3"><i class="bi bi-tag fs-4"></i></div>
                                    <div>
                                        <div class="text-muted small">الموديل</div>
                                        <div class="fw-bold">@Model.Model</div>
                                    </div>
                                </div>
                            </div>

                            <!-- السنة -->
                            <div class="col-md-6 mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-light p-3 rounded-circle me-3"><i class="bi bi-calendar fs-4"></i></div>
                                    <div>
                                        <div class="text-muted small">سنة الصنع</div>
                                        <div class="fw-bold">@Model.Year</div>
                                    </div>
                                </div>
                            </div>

                            <!-- اللون -->
                            <div class="col-md-6 mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-light p-3 rounded-circle me-3"><i class="bi bi-palette fs-4"></i></div>
                                    <div>
                                        <div class="text-muted small">اللون</div>
                                        <div class="fw-bold">@Model.Color</div>
                                    </div>
                                </div>
                            </div>

                            <!-- سعر التكلفة للموظف والمدير فقط -->
                            @if (isAdmin)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light p-3 rounded-circle me-3"><i class="bi bi-currency-dollar fs-4"></i></div>
                                        <div>
                                            <div class="text-muted small">سعر التكلفة</div>
                                            <div class="fw-bold text-primary">@Model.Costing.ToString("C0")</div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- السعر المتوقع -->
                            <div class="col-md-6 mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-light p-3 rounded-circle me-3"><i class="bi bi-bar-chart fs-4"></i></div>
                                    <div>
                                        <div class="text-muted small">السعر المتوقع</div>
                                        <div class="fw-bold">
                                            @if (isAdmin)
                                            {
                                                @($"{Model.EstimatedPriceMin:C0} - {Model.EstimatedPriceMax:C0}")
                                            }
                                            else
                                            {
                                                @Model.EstimatedPriceMax.ToString("C0")
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- الميلج -->
                            @if (Model.IsUsed && Model.Mileage.HasValue)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light p-3 rounded-circle me-3"><i class="bi bi-speedometer2 fs-4"></i></div>
                                        <div>
                                            <div class="text-muted small">المسافة المقطوعة</div>
                                            <div class="fw-bold">@Model.Mileage كم</div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- الحالة -->
                            <div class="col-md-6 mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="@(Model.IsUsed ? "bg-warning" : "bg-success") p-3 rounded-circle me-3">
                                        <i class="bi bi-info-circle fs-4 text-white"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted small">الحالة</div>
                                        <div class="fw-bold">@(Model.IsUsed ? "مستعملة" : "جديدة")</div>
                                    </div>
                                </div>
                            </div>

                            <!-- التوفر -->
                            <div class="col-md-6 mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="@(Model.IsAvailable ? "bg-success" : "bg-danger") p-3 rounded-circle me-3">
                                        <i class="bi bi-check-circle fs-4 text-white"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted small">التوفر</div>
                                        <div class="fw-bold">@(Model.IsAvailable ? "متاحة" : "محجوزة")</div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- زر الحجز -->
                    @if (Model.IsAvailable)
                    {
                        <div class="mt-4">
                            <a asp-action="Book" asp-route-id="@Model.Id" class="btn btn-success btn-lg w-100"><i class="bi bi-calendar-check"></i> حجز السيارة</a>
                        </div>
                    }

                </div>
            </div>

            <!-- الوصف -->
            <div class="mt-4">
                <h3 class="h4">الوصف</h3>
                <p class="lead">@Model.Description</p>
            </div>

        </div>
    </div>
</div>




